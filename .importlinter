# Generated by `python -m scripts.ff.module_map`; do not edit by hand.
# FF-01 import boundaries: the module map, I-18 and the factory SDK rule.
[importlinter]
root_packages =
    grindstone
    grindstone_sdlc
    grindstone_notes
    grindstone_runner
include_external_packages = False

[importlinter:contract:module-contracts]
name = Module map: grindstone.contracts imports only what the module map allows
type = forbidden
source_modules =
    grindstone.contracts
forbidden_modules =
    grindstone.store
    grindstone.platform
    grindstone.intent
    grindstone.evidence
    grindstone.decisions
    grindstone.memory
    grindstone.stations
    grindstone.change
    grindstone.work
    grindstone.delivery
    grindstone.surface
    grindstone.sdk
    grindstone.app
    grindstone.__main__

