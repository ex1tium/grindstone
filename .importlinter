[importlinter:contract:kernel-never-imports-factories]
name = I-18: the kernel never imports a factory
type = forbidden
source_modules =
    grindstone
forbidden_modules =
    grindstone_sdlc
    grindstone_notes

[importlinter:contract:factories-use-only-the-sdk]
name = Factories import only grindstone.sdk
type = forbidden
source_modules =
    grindstone_sdlc
    grindstone_notes
forbidden_modules =
    grindstone.contracts
    grindstone.store
    grindstone.platform
    grindstone.intent
