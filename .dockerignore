# Only what the Dockerfiles copy; everything else stays out of the build context.
**
!pyproject.toml
!uv.lock
!packages/grindstone/pyproject.toml
!packages/grindstone/README.md
!packages/grindstone/src/**
!factories/*/pyproject.toml
!factories/*/src/**
!runner/pyproject.toml
!runner/src/**
!agent-host/package.json
!agent-host/src/**
!docker/entrypoints/**
**/__pycache__
